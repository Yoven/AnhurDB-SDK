# AnhurDB Hermes-memory plugin — configuration.
# Copy this to $HOME/.anhur-hermes-memory/env (mode 0600) and fill in your key.
# The plugin binary READS THAT FILE ITSELF — `export` is kept on every line anyway, so the
# same file also works if you source it from a shell. The API key is sent as the X-API-Key
# header and is NEVER written to the transcript, logs, or stdout.
#
# ⚠ Junior Tip [por que cada linha tem `export` — incidente de 2026-07-18]: uma versão
# anterior deste arquivo NÃO tinha `export`. Os hooks faziam `. <arquivo>` e, em POSIX sh,
# isso cria variável de SHELL que o processo filho NÃO herda: o binário lia chave vazia,
# registrava "not set — skipping" e saía com 0. Resultado: 743 invocações de hook, 743
# skips, ZERO memória gravada por 12,8 dias, em silêncio. O binário passou a ler o arquivo
# diretamente (então `export` já não é obrigatório), mas ele fica aqui de propósito: este
# arquivo é copiado e adaptado por gente e por scripts, e um artefato que só funciona de um
# jeito é um artefato que se conserta sozinho. NÃO remova os `export`.
#
# Use a PER-TENANT key (one key per tenant), NOT the master key. This is the same key the
# AnhurDB MCP tools accept. The Hermes plugin is a SEPARATE memory identity from the default
# Claude plugin — point it at the Hermes tenant's key so the two memories never mix.

# Required: the tenant API key this agent's memory lives under.
export ANHUR_API_KEY=anhur_xxx_replace_with_your_tenant_key

# Your AnhurDB HTTP endpoint.
export ANHUR_URL=https://anhurdb.yoven.ai

# Your memory profile WITHIN the tenant the API key selects. Recall reads STRICTLY from this profile,
# so one stable name = one accumulating memory. CHOOSE IT ONCE: changing it later makes recall stop
# surfacing what was saved under the old name (nothing is lost — it's still there under the old name —
# it just isn't re-surfaced). Keep it stable across sessions.
export ANHUR_CONTAINER=hermes-ltm

# NOTE: saving turns is only half of it. Distilling fact/decision/emotion/etc. from them is done by
# AnhurDB's Smart Units (its cognitive layer). If they aren't enabled on your AnhurDB, turns are
# still saved but no typed memories are derived. See README → "Structured memory (Smart Units)".

# ── Optional tuning ──────────────────────────────────────────────────────────
# ANHUR_RECALL_LIMIT=8                       # max items per section injected at session start
# ANHUR_HTTP_TIMEOUT=15                      # seconds per HTTP call
#
# ANHUR_MAX_CHUNK_CHARS=24000               # SIZE of each persisted chunk. A long delta is
#                                           # split into N chunks of this size and ALL of them
#                                           # are persisted (queued on failure) — nothing is
#                                           # truncated/dropped (no-silent-loss). Bigger means
#                                           # fewer/larger records (mind the per-memory size cap and
#                                           # the Smart Unit processing load).
#
# ANHUR_INCLUDE_TOOLS=calls                 # how tool blocks are persisted:
#                                           #   none  = conversation text only
#                                           #   calls = text + a COMPACT tool_use line (default)
#                                           #   all   = the above + a TRUNCATED tool_result
#                                           # (thinking blocks are never persisted)
#
# ANHUR_STATE_DIR=$HOME/.anhur-hermes-memory # queue + cursors + log live here (never committed)

# Only needed if you let THIS plugin register the MCP server (.mcp.json). Points at anhur-mcp.
# ANHUR_MCP_URL=https://anhurdb.yoven.ai/mcp
