# AnhurDB memory provider (Hermes Agent) — configuration example.
#
# Copy this to $HOME/.anhur-hermes-memory/env and `chmod 0600` it, OR let
# `hermes memory setup` write the same variables into ~/.hermes/.env. Both work;
# the plugin reads BOTH and the process environment always wins.
#
# ⚠ Junior Tip [por que TODA linha tem `export` — incidente de 2026-07-18 a
# 2026-07-30]: a versão anterior deste arquivo perdeu os `export`. Os hooks do
# plugin irmão faziam `. <arquivo>` e, em POSIX sh, isso cria variável de SHELL
# que o processo filho NÃO herda: o binário lia chave vazia, registrava
# "not set — skipping" e saía com código 0, stdout e stderr vazios. Resultado:
# 743 invocações, 743 skips, ZERO memória gravada por 12,8 dias, em silêncio.
# Este plugin lê o arquivo por conta própria (config.py), então `export` já não
# é tecnicamente necessário — e ele fica aqui de propósito: este arquivo é
# copiado e adaptado por gente e por scripts, e um artefato que só funciona de
# um jeito é um artefato que se conserta sozinho. NÃO remova os `export`.

# ── Required ─────────────────────────────────────────────────────────────────
# The TENANT API key (one key per tenant) — never the master key. It is sent as
# the X-API-Key header and is never logged, printed, or written to disk by this
# plugin. Only its SOURCE (environment | file | missing) reaches the log.
export ANHUR_API_KEY=anhur_xxx_replace_with_your_tenant_key

# ── Endpoint ─────────────────────────────────────────────────────────────────
# Defaults to the SDK's own DEFAULT_CLOUD_URL when unset.
export ANHUR_URL=https://anhurdb.yoven.ai

# Memory profile (container tag) WITHIN the tenant the key selects. It scopes
# the profile block injected at session start and is stamped into every record.
# CHOOSE IT ONCE and keep it stable: changing it later stops surfacing what was
# saved under the old name (nothing is lost — it just is not re-surfaced).
export ANHUR_CONTAINER=hermes-ltm

# ── Optional tuning (defaults shown) ─────────────────────────────────────────
# Queue, quarantine, and plugin.log live here. Include it in your backups —
# a queued turn has NOT reached AnhurDB yet. `backup_paths()` declares it to
# `hermes backup` automatically.
# export ANHUR_STATE_DIR=$HOME/.anhur-hermes-memory

# Read the configuration from somewhere else entirely (CI, key rotation).
# export ANHUR_ENV_FILE=$HOME/.anhur-hermes-memory/env

# Seconds per WRITE call (session registration + ingest). Writes run on the
# host's background worker, so a slow server delays memory, not the user.
# export ANHUR_HTTP_TIMEOUT=15

# Seconds per RECALL call. Deliberately shorter: prefetch runs INLINE on the
# turn path, so this is time the user waits before seeing a reply.
# export ANHUR_PREFETCH_TIMEOUT=5

# Max items per section in the injected profile block, and max hits per recall.
# export ANHUR_RECALL_LIMIT=8

# Size of each persisted chunk. A long turn is split into N chunks and ALL of
# them are persisted (queued on failure) — nothing is truncated or dropped.
# export ANHUR_MAX_CHUNK_CHARS=24000
